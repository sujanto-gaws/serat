{
  "$schema": "serat design tokens — P1",
  "meta": {
    "source": "docs/03-design/ui/serat-identity.md",
    "principles": [
      "Indigo is the one interactive accent. Brass marks a secondary, always-earned signal (unsaved, thread/link, a pending or attention state) — never a button, never a wash.",
      "Flat by construction: no gradients, no card shadows, no bevels — the identity's rule for the mark extended to the shell. The one exception is a short, restrained elevation shadow on floating overlays (palette, switcher, tooltip) that must read as above the page.",
      "Three type families, three jobs, never mixed: Bricolage Grotesque is the app's own voice (chrome, controls, labels). Source Serif 4 is the vault's voice (rendered prose, excerpts, anything quoted from a note). JetBrains Mono is the machine's voice (paths, hashes, byte ranges, raw source, keybinding glyphs, the [key:value] filter).",
      "Structure over decoration: indentation, dividers and counts carry information (tree depth, folded sidecars, proposal counts). Nothing is added to look finished.",
      "Dark theme is P2 (NFR-USE-03); this file specifies light only. Colour roles are named, not hard-coded, in components.md so a dark ramp can be added without renaming anything."
    ]
  },
  "color": {
    "brand": {
      "indigo": "#24457E",
      "brass": "#C08A47",
      "ink": "#16191B",
      "paper": "#F3F4F1"
    },
    "indigo": {
      "50": "#EFF2F8",
      "100": "#E4E9F2",
      "500": "#2F569B",
      "600": "#24457E",
      "700": "#1B3660"
    },
    "brass": {
      "100": "#F3E6D2",
      "500": "#C08A47",
      "600": "#A5763A"
    },
    "rust": {
      "_comment": "The one functional error/destructive hue, restrained and warm-dark rather than saturated red — used only for refusals, conflicts and destructive confirmations, never for ordinary UI.",
      "100": "#F1DAD3",
      "500": "#9C4A3A",
      "600": "#7E3A2C"
    },
    "neutral": {
      "_comment": "Interpolated between paper and ink; the working greys for surfaces, borders and secondary text.",
      "50": "#F3F4F1",
      "100": "#E7E8E4",
      "200": "#D3D5CE",
      "300": "#B4B7AE",
      "400": "#8C9088",
      "500": "#6B6F67",
      "600": "#4C4F49",
      "700": "#33352F",
      "900": "#16191B"
    },
    "role": {
      "bg-app": "{neutral.50}",
      "bg-surface": "#FFFFFE",
      "bg-surface-sunken": "{neutral.100}",
      "bg-overlay": "#FFFFFE",
      "bg-selected": "{indigo.100}",
      "bg-selected-weak": "{indigo.50}",
      "bg-pending-stripe": "{neutral.100}",
      "border-hairline": "{neutral.200}",
      "border-strong": "{neutral.300}",
      "border-focus": "{indigo.600}",
      "text-primary": "{neutral.900}",
      "text-secondary": "{neutral.600}",
      "text-tertiary": "{neutral.400}",
      "text-on-indigo": "{brand.paper}",
      "text-link": "{indigo.600}",
      "accent-interactive": "{indigo.600}",
      "accent-interactive-hover": "{indigo.700}",
      "accent-secondary": "{brass.500}",
      "accent-secondary-hover": "{brass.600}",
      "accent-secondary-bg": "{brass.100}",
      "accent-error": "{rust.500}",
      "accent-error-hover": "{rust.600}",
      "accent-error-bg": "{rust.100}",
      "unsaved-dot": "{brass.500}",
      "unresolved-link": "{rust.500}",
      "conflict-bg": "{brass.100}",
      "conflict-border": "{brass.500}"
    }
  },
  "typography": {
    "families": {
      "ui": "'Bricolage Grotesque', system-ui, sans-serif",
      "prose": "'Source Serif 4', Georgia, serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "micro":       { "size": "11px", "lineHeight": "14px", "family": "mono",  "tracking": "0" },
      "small":       { "size": "12px", "lineHeight": "16px", "family": "ui",    "tracking": "0" },
      "ui":          { "size": "13px", "lineHeight": "18px", "family": "ui",    "tracking": "0" },
      "ui-medium":   { "size": "13px", "lineHeight": "18px", "family": "ui",    "tracking": "0", "weight": 500 },
      "input":       { "size": "15px", "lineHeight": "20px", "family": "ui",    "tracking": "0" },
      "mono-source": { "size": "14.5px", "lineHeight": "24px", "family": "mono", "tracking": "0" },
      "body-serif":  { "size": "17px", "lineHeight": "28px", "family": "prose", "tracking": "0" },
      "body-serif-lg": { "size": "19px", "lineHeight": "31px", "family": "prose", "tracking": "0" },
      "heading-sm":  { "size": "19px", "lineHeight": "26px", "family": "ui", "tracking": "-0.01em", "weight": 700 },
      "heading-md":  { "size": "23px", "lineHeight": "29px", "family": "ui", "tracking": "-0.015em", "weight": 700 },
      "heading-lg":  { "size": "28px", "lineHeight": "34px", "family": "ui", "tracking": "-0.02em", "weight": 700 },
      "display":     { "size": "34px", "lineHeight": "40px", "family": "ui", "tracking": "-0.025em", "weight": 700 }
    },
    "measure": {
      "prose-max": "72ch",
      "prose-min-comfortable": "52ch"
    }
  },
  "space": {
    "0": "0", "1": "2px", "2": "4px", "3": "8px", "4": "12px", "5": "16px",
    "6": "20px", "7": "24px", "8": "32px", "9": "40px", "10": "56px", "11": "72px"
  },
  "radius": {
    "none": "0",
    "sm": "3px",
    "md": "6px",
    "chip": "3px",
    "note": "0"
  },
  "border": {
    "hairline": "1px solid {color.role.border-hairline}",
    "focus-ring": "2px solid {color.role.border-focus}",
    "focus-ring-offset": "1px"
  },
  "elevation": {
    "_comment": "Used only on floating layers: command palette, quick switcher, tooltips, the conflict notice. Never on a panel, list row or button.",
    "overlay": "0 4px 16px rgba(22,25,27,0.16), 0 1px 2px rgba(22,25,27,0.08)",
    "flat": "none"
  },
  "motion": {
    "duration": { "micro": "120ms", "panel": "160ms", "overlay": "220ms" },
    "easing": { "enter": "cubic-bezier(0.2,0,0,1)", "exit": "cubic-bezier(0.4,0,1,1)" },
    "reduced-motion": "durations collapse to 1ms; overlay open/close becomes an opacity fade only, per prefers-reduced-motion"
  },
  "layout": {
    "titlebar-height": "40px",
    "tree-pane-width-default": "260px",
    "tree-pane-width-min": "180px",
    "tree-pane-width-max": "420px",
    "context-pane-width-default": "300px",
    "context-pane-width-min": "220px",
    "row-height-tree": "26px",
    "row-height-list": "28px",
    "breakpoint-narrow": "960px",
    "breakpoint-compact": "720px"
  },
  "iconography": {
    "style": "flat, single-weight line icons at 16px/20px on a 24-unit grid; no fill except the Serat mark itself and status dots (unsaved brass, error rust)",
    "note-mark": "two staggered strokes (the lontar reduction) — never the full three-strip mark below 20px"
  }
}
